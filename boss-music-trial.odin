GW_Hat_Static_process :: proc(p: ^GW_Hat_Static_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Hat_Static_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_static_amp_stage != .Release && voice.adsr_static_amp_stage != .Idle {
				voice.adsr_static_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_static_amp_out: f32 = 0.0
		node_static_filter_out: f32 = 0.0
		node_static_noise_out: f32 = 0.0
		node_static_output_out: f32 = 0.0

		// --- Noise Node static_noise ---
		node_static_noise_out = (next_float32(&voice.noise_static_noise_rng) * 2.0 - 1.0) * (p.amplitude);

		// --- Filter Node static_filter (SVF) ---
		{
			cutoff_c_static_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_static_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_static_filter / sample_rate));
			q_static_filter: f32 = math.clamp(1.0 / math.max(f32(f32(1.100000000)), 0.1), 0.05, 1.9 - f_static_filter);
			voice.filter_static_filter_low += f_static_filter * voice.filter_static_filter_band;
			high_static_filter := f32(((node_static_noise_out)) - voice.filter_static_filter_low - q_static_filter * voice.filter_static_filter_band);
			voice.filter_static_filter_band += f_static_filter * high_static_filter;
			node_static_filter_out = voice.filter_static_filter_band;
		}

		// --- ADSR Node static_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_static_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.age / math.max(f32(f32(0.001000000)), 0.000001); else do envelope = 1.0;
				voice.adsr_static_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_static_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_static_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_static_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_static_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_static_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.020000000)) > 0 do envelope = voice.adsr_static_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.020000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_static_amp_stage = .Idle;
				}
			}
			vel_scale_static_amp: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_static_amp_out = ((node_static_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_static_amp;
		}

		output_left += node_static_amp_out
		output_right += node_static_amp_out
		if voice.adsr_static_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return output_left * f32(0.449999988), output_right * f32(0.449999988)
}
GW_Hat_Static_process_sequence :: proc(p: ^GW_Hat_Static_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Hat Static" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Hat_Static_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 1:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			GW_Hat_Static_set_param(p, "decay", 0.119999997)
			GW_Hat_Static_note_on(p, 42, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Hat_Static_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Hat_Static_set_param(p, "decay", 0.119999997)
			GW_Hat_Static_note_on(p, 42, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Hat_Static_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 9:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Hat_Static_set_param(p, "decay", 0.119999997)
			GW_Hat_Static_note_on(p, 42, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Hat_Static_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			GW_Hat_Static_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			GW_Hat_Static_set_param(p, "decay", 0.119999997)
			GW_Hat_Static_note_on(p, 42, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			if next_float32(&p.prng) <= 0.699999988 {
				GW_Hat_Static_note_on(p, 42, 0.400000006, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

