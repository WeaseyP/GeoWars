Tuba_set_param :: proc(p: ^Tuba_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack":
		Tuba_set_Amp_attack(p, value)
		return true
	case "Amp_decay":
		Tuba_set_Amp_decay(p, value)
		return true
	case "Amp_depth":
		Tuba_set_Amp_depth(p, value)
		return true
	case "Amp_release":
		Tuba_set_Amp_release(p, value)
		return true
	case "Amp_sustain":
		Tuba_set_Amp_sustain(p, value)
		return true
	case "Blow_attack":
		Tuba_set_Blow_attack(p, value)
		return true
	case "Blow_decay":
		Tuba_set_Blow_decay(p, value)
		return true
	case "Blow_depth":
		Tuba_set_Blow_depth(p, value)
		return true
	case "Blow_release":
		Tuba_set_Blow_release(p, value)
		return true
	case "Blow_sustain":
		Tuba_set_Blow_sustain(p, value)
		return true
	case "Buzz_amplitude":
		Tuba_set_Buzz_amplitude(p, value)
		return true
	case "Vibrato_amplitude":
		Tuba_set_Vibrato_amplitude(p, value)
		return true
	case "cutoff":
		Tuba_set_cutoff(p, value)
		return true
	case "frequency":
		Tuba_set_frequency(p, value)
		return true
	case "outMax":
		Tuba_set_outMax(p, value)
		return true
	case "resonance":
		Tuba_set_resonance(p, value)
		return true
	case "velocitySensitivity":
		Tuba_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Tuba_get_param :: proc(p: ^Tuba_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack":
		return p.Amp_attack, true
	case "Amp_decay":
		return p.Amp_decay, true
	case "Amp_depth":
		return p.Amp_depth, true
	case "Amp_release":
		return p.Amp_release, true
	case "Amp_sustain":
		return p.Amp_sustain, true
	case "Blow_attack":
		return p.Blow_attack, true
	case "Blow_decay":
		return p.Blow_decay, true
	case "Blow_depth":
		return p.Blow_depth, true
	case "Blow_release":
		return p.Blow_release, true
	case "Blow_sustain":
		return p.Blow_sustain, true
	case "Buzz_amplitude":
		return p.Buzz_amplitude, true
	case "Vibrato_amplitude":
		return p.Vibrato_amplitude, true
	case "cutoff":
		return p.cutoff, true
	case "frequency":
		return p.frequency, true
	case "outMax":
		return p.outMax, true
	case "resonance":
		return p.resonance, true
	case "velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Tuba_process :: proc(p: ^Tuba_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Tuba_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_tuba_amp_stage != .Release && voice.adsr_tuba_amp_stage != .Idle {
				voice.adsr_tuba_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_tuba_blow_stage != .Release && voice.adsr_tuba_blow_stage != .Idle {
				voice.adsr_tuba_blow_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_tuba_amp_out: f32 = 0.0
		node_tuba_blow_out: f32 = 0.0
		node_tuba_blow_map_out: f32 = 0.0
		node_tuba_filter_out: f32 = 0.0
		node_tuba_osc_out: f32 = 0.0
		node_tuba_output_out: f32 = 0.0
		node_tuba_vibrato_out: f32 = 0.0

		// --- ADSR Node tuba_blow ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_tuba_blow_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Blow_attack) > 0 do envelope = voice.age / math.max(f32(p.Blow_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_tuba_blow_release_level = envelope;
				if voice.age >= (p.Blow_attack) {
					voice.adsr_tuba_blow_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Blow_attack);
				if (p.Blow_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Blow_decay), 0.000001)) * (1.0 - (p.Blow_sustain)); else do envelope = (p.Blow_sustain);
				voice.adsr_tuba_blow_release_level = envelope;
				if time_in_decay >= (p.Blow_decay) {
					voice.adsr_tuba_blow_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Blow_sustain);
				voice.adsr_tuba_blow_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_tuba_blow_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Blow_release) > 0 do envelope = voice.adsr_tuba_blow_release_level * (1.0 - (time_in_release / math.max(f32(p.Blow_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_tuba_blow_stage = .Idle;
				}
			}
			vel_scale_tuba_blow: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_tuba_blow_out = (1.0) * envelope * (p.Blow_depth) * vel_scale_tuba_blow;
		}

		// --- LFO Node tuba_vibrato ---
		voice.lfo_tuba_vibrato_phase = math.mod(voice.lfo_tuba_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_tuba_vibrato_phase < 0.0 do voice.lfo_tuba_vibrato_phase += 2 * f32(math.PI);
		node_tuba_vibrato_out = math.sin(voice.lfo_tuba_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Mapper Node tuba_blow_map ---
		{
			in_range_tuba_blow_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_tuba_blow_map == 0.0 do in_range_tuba_blow_map = 1.0;
			node_tuba_blow_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_tuba_blow_out)) - f32(f32(0.000000000))) / in_range_tuba_blow_map, 0.0, 1.0));
		}

		// --- Oscillator Node tuba_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_tuba_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_tuba_osc_phase[i] = math.mod(voice.osc_tuba_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_tuba_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			if unison_count > 0 do node_tuba_osc_out = (unison_out / f32(unison_count)) * (p.Buzz_amplitude);
		}

		// --- Filter Node tuba_filter (SVF) ---
		{
			cutoff_c_tuba_filter: f32 = math.clamp(f32((p.cutoff) + (node_tuba_blow_map_out)), 10.0, sample_rate * 0.16);
			f_tuba_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_tuba_filter / sample_rate));
			q_tuba_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_tuba_filter);
			voice.filter_tuba_filter_low += f_tuba_filter * voice.filter_tuba_filter_band;
			high_tuba_filter := f32(((node_tuba_osc_out)) - voice.filter_tuba_filter_low - q_tuba_filter * voice.filter_tuba_filter_band);
			voice.filter_tuba_filter_band += f_tuba_filter * high_tuba_filter;
			node_tuba_filter_out = voice.filter_tuba_filter_low;
		}

		// --- ADSR Node tuba_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_tuba_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.age / math.max(f32(p.Amp_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_tuba_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_tuba_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_tuba_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_tuba_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_tuba_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_tuba_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_tuba_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_tuba_amp_stage = .Idle;
				}
			}
			vel_scale_tuba_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_tuba_amp_out = ((node_tuba_filter_out)) * envelope * (p.Amp_depth) * vel_scale_tuba_amp;
		}

		output_left += node_tuba_amp_out
		output_right += node_tuba_amp_out
		if voice.adsr_tuba_amp_stage != .Idle do voice_busy = true
		if voice.adsr_tuba_blow_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return output_left * f32(0.850000024), output_right * f32(0.850000024)
}
Tuba_process_sequence :: proc(p: ^Tuba_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Tuba" (16 steps)
		switch p.current_step % 16 {
		case 6:
			Tuba_note_on(p, 60, 1.000000000, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Tuba_note_on(p, 60, 1.000000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Growly_Sax_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	filter_growl_air_low: f32,
	filter_growl_air_band: f32,
	adsr_growl_amp_stage: ADSR_Stage,
	adsr_growl_amp_release_level: f32,
	filter_growl_body_low: f32,
	filter_growl_body_band: f32,
	noise_growl_breath_rng: PRNG_State,
	noise_growl_breath_p0: f32,
	noise_growl_breath_p1: f32,
	noise_growl_breath_p2: f32,
	dist_growl_drive_tone: f32,
	filter_growl_formant_low: f32,
	filter_growl_formant_band: f32,
	adsr_growl_puff_stage: ADSR_Stage,
	adsr_growl_puff_release_level: f32,
	osc_growl_reed_phase: [1]f32,
	adsr_growl_scoop_stage: ADSR_Stage,
	adsr_growl_scoop_release_level: f32,
	lfo_growl_vibrato_phase: f32,
}

Growly_Sax_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [4]Growly_Sax_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	delay_growl_reverb_buffer: [96000]f32,
	delay_growl_reverb_write_index: int,
	Air_cutoff: f32,
	Air_resonance: f32,
	Amp_attack: f32,
	Amp_decay: f32,
	Amp_depth: f32,
	Amp_release: f32,
	Amp_sustain: f32,
	Body_cutoff: f32,
	Body_resonance: f32,
	Breath_amplitude: f32,
	Expression_mix: f32,
	Formant_cutoff: f32,
	Formant_resonance: f32,
	Puff_attack: f32,
	Puff_decay: f32,
	Puff_depth: f32,
	Puff_release: f32,
	Puff_sustain: f32,
	Reed_amplitude: f32,
	Room_decay: f32,
	Room_mix: f32,
	Scoop_attack: f32,
	Scoop_depth: f32,
	Scoop_release: f32,
	Scoop_sustain: f32,
	Vibrato_amplitude: f32,
	drive: f32,
	frequency: f32,
	outMin: f32,
	tone: f32,
	velocitySensitivity: f32,
}

Growly_Sax_init :: proc(p: ^Growly_Sax_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 145.000000000
	p.prng.state = 12345
	p.loop = true
	for i in 0..<4 {
		v := &p.voices[i]
		v.noise_growl_breath_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.Air_cutoff = 4500.000000000
	p.Air_resonance = 1.000000000
	p.Amp_attack = 0.050000001
	p.Amp_decay = 0.180000007
	p.Amp_depth = 1.000000000
	p.Amp_release = 0.140000001
	p.Amp_sustain = 0.800000012
	p.Body_cutoff = 1600.000000000
	p.Body_resonance = 1.200000048
	p.Breath_amplitude = 0.150000006
	p.Expression_mix = 0.250000000
	p.Formant_cutoff = 1100.000000000
	p.Formant_resonance = 2.500000000
	p.Puff_attack = 0.010000000
	p.Puff_decay = 0.119999997
	p.Puff_depth = 1.000000000
	p.Puff_release = 0.079999998
	p.Puff_sustain = 0.250000000
	p.Reed_amplitude = 0.550000012
	p.Room_decay = 1.500000000
	p.Room_mix = 0.150000006
	p.Scoop_attack = 0.070000000
	p.Scoop_depth = 1.000000000
	p.Scoop_release = 0.050000001
	p.Scoop_sustain = 1.000000000
	p.Vibrato_amplitude = 0.020000000
	p.drive = 18.000000000
	p.frequency = 5.500000000
	p.outMin = -0.119999997
	p.tone = 5000.000000000
	p.velocitySensitivity = 0.800000012
}

Growly_Sax_note_on :: proc(p: ^Growly_Sax_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<4 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.039999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.filter_growl_air_low = 0.0
	v.filter_growl_air_band = 0.0
	v.adsr_growl_amp_stage = .Attack
	v.adsr_growl_amp_release_level = 0.0
	v.filter_growl_body_low = 0.0
	v.filter_growl_body_band = 0.0
	v.dist_growl_drive_tone = 0.0
	v.filter_growl_formant_low = 0.0
	v.filter_growl_formant_band = 0.0
	v.adsr_growl_puff_stage = .Attack
	v.adsr_growl_puff_release_level = 0.0
	v.osc_growl_reed_phase = {}
	v.adsr_growl_scoop_stage = .Attack
	v.adsr_growl_scoop_release_level = 0.0
}

Growly_Sax_note_off :: proc(p: ^Growly_Sax_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_growl_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_growl_amp_stage = .Release
		p.voices[best].adsr_growl_puff_stage = .Release
		p.voices[best].adsr_growl_scoop_stage = .Release
	}
}

Growly_Sax_trigger :: proc(p: ^Growly_Sax_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Puff_attack) + (p.Puff_decay) > d do d = (p.Puff_attack) + (p.Puff_decay)
		if (p.Scoop_attack) + (f32(0.200000000)) > d do d = (p.Scoop_attack) + (f32(0.200000000))
		if d <= 0.0 do d = 0.001
	}
	Growly_Sax_note_on(p, note, velocity, d)
}

Growly_Sax_feed_input :: proc(p: ^Growly_Sax_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Growly_Sax_start :: proc(p: ^Growly_Sax_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Growly_Sax_stop :: proc(p: ^Growly_Sax_Processor) {
	p.playing = false
}

Growly_Sax_set_loop :: proc(p: ^Growly_Sax_Processor, loop: bool) {
	p.loop = loop
}

Growly_Sax_is_playing :: proc(p: ^Growly_Sax_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	return false
}

Growly_Sax_set_Air_cutoff :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.Air_cutoff = v
}

