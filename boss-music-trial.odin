GW_Grunt_Swarm_Bass_note_on :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<4 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_grunt_amp_stage = .Attack
	v.adsr_grunt_amp_release_level = 0.0
	v.dist_grunt_dirt_tone = 0.0
	v.filter_grunt_filter_low = 0.0
	v.filter_grunt_filter_band = 0.0
	v.osc_grunt_osc_phase = {}
}

GW_Grunt_Swarm_Bass_note_off :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_grunt_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_grunt_amp_stage = .Release
	}
}

GW_Grunt_Swarm_Bass_trigger :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
