Growly_Sax_set_Room_decay :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.Room_decay = v
}

Growly_Sax_set_Room_mix :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Room_mix = v
}

Growly_Sax_set_Scoop_attack :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.Scoop_attack = v
}

Growly_Sax_set_Scoop_depth :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Scoop_depth = v
}

Growly_Sax_set_Scoop_release :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.Scoop_release = v
}

Growly_Sax_set_Scoop_sustain :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Scoop_sustain = v
}

Growly_Sax_set_Vibrato_amplitude :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.Vibrato_amplitude = v
}

Growly_Sax_set_drive :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 1.000000000 do v = 1.000000000
	if v > 100.000000000 do v = 100.000000000
	p.drive = v
}

Growly_Sax_set_frequency :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 100.000000000 do v = 100.000000000
	p.frequency = v
}

Growly_Sax_set_outMin :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < -1000000.000000000 do v = -1000000.000000000
	if v > 1000000.000000000 do v = 1000000.000000000
	p.outMin = v
}

Growly_Sax_set_tone :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 100.000000000 do v = 100.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.tone = v
}

Growly_Sax_set_velocitySensitivity :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.velocitySensitivity = v
}

