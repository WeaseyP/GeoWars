GW_Splitter_Echo_Stab_get_param :: proc(p: ^GW_Splitter_Echo_Stab_Processor, name: string) -> (f32, bool) {
	switch name {
	case "amplitude":
		return p.amplitude, true
	case "cutoff":
		return p.cutoff, true
	case "decay":
		return p.decay, true
	case "feedback":
		return p.feedback, true
	case "mix":
		return p.mix, true
	case "pulseWidth":
		return p.pulseWidth, true
	case "release":
		return p.release, true
	case "resonance":
		return p.resonance, true
	}
	return 0.0, false
}

GW_Splitter_Echo_Stab_process :: proc(p: ^GW_Splitter_Echo_Stab_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Splitter_Echo_Stab_process_sequence(p)
	p.total_samples += 1

	node_split_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<5 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_split_amp_stage != .Release && voice.adsr_split_amp_stage != .Idle {
				voice.adsr_split_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_split_amp_out: f32 = 0.0
		node_split_filter_out: f32 = 0.0
		node_split_osc_out: f32 = 0.0

		// --- Oscillator Node split_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_split_osc_phase[i] = math.mod(voice.osc_split_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_split_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			if unison_count > 0 do node_split_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node split_filter (SVF) ---
		{
			cutoff_c_split_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_split_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_split_filter / sample_rate));
			q_split_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_split_filter);
			voice.filter_split_filter_low += f_split_filter * voice.filter_split_filter_band;
			high_split_filter := f32(((node_split_osc_out)) - voice.filter_split_filter_low - q_split_filter * voice.filter_split_filter_band);
			voice.filter_split_filter_band += f_split_filter * high_split_filter;
			node_split_filter_out = voice.filter_split_filter_low;
		}

		// --- ADSR Node split_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_split_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.003000000)) > 0 do envelope = voice.age / math.max(f32(f32(0.003000000)), 0.000001); else do envelope = 1.0;
				voice.adsr_split_amp_release_level = envelope;
				if voice.age >= (f32(0.003000000)) {
					voice.adsr_split_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.003000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_split_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_split_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_split_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_split_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_split_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_split_amp_stage = .Idle;
				}
			}
			vel_scale_split_amp: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_split_amp_out = ((node_split_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_split_amp;
		}

		node_split_amp_out_vsum += node_split_amp_out
		if voice.adsr_split_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_split_amp_out := node_split_amp_out_vsum
		node_split_echo_out: f32 = 0.0
		// --- Delay Node split_echo ---
		{
			delay_samples_split_echo := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_split_echo := (p.delay_split_echo_write_index - delay_samples_split_echo + len(p.delay_split_echo_buffer)) % len(p.delay_split_echo_buffer);
			delayed_sample_split_echo := p.delay_split_echo_buffer[read_index_split_echo];
			p.delay_split_echo_buffer[p.delay_split_echo_write_index] = ((node_split_amp_out)) + delayed_sample_split_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_split_echo_write_index = (p.delay_split_echo_write_index + 1) % len(p.delay_split_echo_buffer);
			node_split_echo_out = ((node_split_amp_out)) * (1.0 - (p.mix)) + delayed_sample_split_echo * (p.mix);
		}

		output_left += node_split_echo_out
		output_right += node_split_echo_out
	}
	return output_left * f32(0.579999983), output_right * f32(0.579999983)
}
GW_Splitter_Echo_Stab_process_sequence :: proc(p: ^GW_Splitter_Echo_Stab_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Splitter Echo Stab" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Splitter_Echo_Stab_note_on(p, 50, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			GW_Splitter_Echo_Stab_note_on(p, 53, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Splitter_Echo_Stab_note_on(p, 50, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Splitter_Echo_Stab_note_on(p, 45, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Splitter_Echo_Stab_note_on(p, 48, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			if next_float32(&p.prng) <= 0.600000024 {
				GW_Splitter_Echo_Stab_note_on(p, 50, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Tuba_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_tuba_amp_stage: ADSR_Stage,
	adsr_tuba_amp_release_level: f32,
	adsr_tuba_blow_stage: ADSR_Stage,
	adsr_tuba_blow_release_level: f32,
	filter_tuba_filter_low: f32,
	filter_tuba_filter_band: f32,
	osc_tuba_osc_phase: [1]f32,
	lfo_tuba_vibrato_phase: f32,
}

Tuba_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]Tuba_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	Amp_attack: f32,
	Amp_decay: f32,
	Amp_depth: f32,
	Amp_release: f32,
	Amp_sustain: f32,
	Blow_attack: f32,
	Blow_decay: f32,
	Blow_depth: f32,
	Blow_release: f32,
	Blow_sustain: f32,
	Buzz_amplitude: f32,
	Vibrato_amplitude: f32,
	cutoff: f32,
	frequency: f32,
	outMax: f32,
	resonance: f32,
	velocitySensitivity: f32,
}

Tuba_init :: proc(p: ^Tuba_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 145.000000000
	p.prng.state = 12345
	p.loop = true
	p.Amp_attack = 0.079999998
	p.Amp_decay = 0.100000001
	p.Amp_depth = 1.000000000
	p.Amp_release = 0.180000007
	p.Amp_sustain = 0.850000024
	p.Blow_attack = 0.090000004
	p.Blow_decay = 0.250000000
	p.Blow_depth = 1.000000000
	p.Blow_release = 0.150000006
	p.Blow_sustain = 0.349999994
	p.Buzz_amplitude = 0.600000024
	p.Vibrato_amplitude = 0.020000000
	p.cutoff = 220.000000000
	p.frequency = 5.000000000
	p.outMax = 700.000000000
	p.resonance = 0.800000012
	p.velocitySensitivity = 0.699999988
}

Tuba_note_on :: proc(p: ^Tuba_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.039999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_tuba_amp_stage = .Attack
	v.adsr_tuba_amp_release_level = 0.0
	v.adsr_tuba_blow_stage = .Attack
	v.adsr_tuba_blow_release_level = 0.0
	v.filter_tuba_filter_low = 0.0
	v.filter_tuba_filter_band = 0.0
	v.osc_tuba_osc_phase = {}
}

Tuba_note_off :: proc(p: ^Tuba_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_tuba_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_tuba_amp_stage = .Release
		p.voices[best].adsr_tuba_blow_stage = .Release
	}
}

Tuba_trigger :: proc(p: ^Tuba_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Blow_attack) + (p.Blow_decay) > d do d = (p.Blow_attack) + (p.Blow_decay)
		if d <= 0.0 do d = 0.001
	}
	Tuba_note_on(p, note, velocity, d)
}

Tuba_feed_input :: proc(p: ^Tuba_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Tuba_start :: proc(p: ^Tuba_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Tuba_stop :: proc(p: ^Tuba_Processor) {
	p.playing = false
}

Tuba_set_loop :: proc(p: ^Tuba_Processor, loop: bool) {
	p.loop = loop
}

Tuba_is_playing :: proc(p: ^Tuba_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

Tuba_set_Amp_attack :: proc(p: ^Tuba_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.Amp_attack = v
}

